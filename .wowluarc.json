{
    "ignore": [".release/"],
    "library": ["Libs/"],
    "flavors": ["retail"],
    "diagnostics": {
        "disable": ["generic-constraint-mismatch", "type-mismatch"],
        "severity": {
            "undefined-field": "info"
        }
    },
    "globals": {
        "read": ["WhoDat*", "WDUtils"],
        "write": ["WhoDat*", "WDUtils", "GRM", "GRM_R", "GRM_API"]
    }
}